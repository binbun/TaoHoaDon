PORT=4000
DATABASE_URL="file:../../prisma/dev.db" # Or postgresql://postgres:postgres@localhost:5432/quotations
JWT_SECRET="your-jwt-secret-key-min-32-chars"
CLIENT_URL="http://localhost:5173"

# --- AI assistant (chatbox) ---
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model name - check AI Studio for the current list
AI_MODEL="gemini-3.8-flash"
# Thinking level: minimal | low | medium | high (default low for Gemini; "default" = provider default)
# AI_REASONING_EFFORT="low"
# Optional: use another OpenAI-compatible provider instead of Gemini
# AI_BASE_URL="https://api.openai.com/v1"   + AI_API_KEY="..."  (OpenAI)
# AI_BASE_URL="http://localhost:11434/v1"   (Ollama, no key)
