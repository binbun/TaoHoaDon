generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("ADMIN") // SUPER_ADMIN, ADMIN, USER
  tokenVersion Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  quotations   Quotation[]
  auditLogs    AuditLog[]
}

model Customer {
  id          String      @id @default(uuid())
  companyName String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxCode     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quotations  Quotation[]
}

model Product {
  id               String          @id @default(uuid())
  code             String          @unique
  oldCode          String?
  name             String
  brand            String          @default("GROB")
  category         String          @default("Khác")
  shortDescription String?
  cabinetWidth     String?
  dimensions       String?
  unit             String          @default("Bộ")
  price            Decimal         @default(0) @db.Decimal(18, 4)
  retailPrice      Decimal?        @default(0) @db.Decimal(18, 4)
  discountRate     Decimal?        @default(0) @db.Decimal(5, 2)
  vatRate          Decimal         @default(0) @db.Decimal(5, 2)
  active           Boolean         @default(true)
  isFavorite       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  quotationItems   QuotationItem[]
}

model Quotation {
  id                String          @id @default(uuid())
  quotationNumber   String          @unique
  invoiceType       String          @default("STANDARD") // STANDARD, CREDIT_NOTE, DEBIT_NOTE
  originalInvoiceId String?
  originalInvoice   Quotation?      @relation("InvoiceAdjustments", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  adjustments       Quotation[]     @relation("InvoiceAdjustments")
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationDate     DateTime        @default(now())
  validUntil        DateTime
  title             String          @default("HÓA ĐƠN BÁN HÀNG")
  note              String?
  status            String          @default("DRAFT") // DRAFT, ISSUED, SENT, PARTIALLY_PAID, PAID, OVERDUE, VOIDED, CANCELLED
  currency          String          @default("VND")
  exchangeRate      Decimal         @default(1.0) @db.Decimal(18, 6)
  subtotal          Decimal         @default(0) @db.Decimal(18, 2)
  discountTotal     Decimal         @default(0) @db.Decimal(18, 2)
  taxableTotal      Decimal         @default(0) @db.Decimal(18, 2)
  vatTotal          Decimal         @default(0) @db.Decimal(18, 2)
  previousDebt      Decimal         @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal         @default(0) @db.Decimal(18, 2)
  balanceDue        Decimal         @default(0) @db.Decimal(18, 2)
  issuedAt          DateTime?
  voidedAt          DateTime?
  voidReason        String?
  voidedBy          String?
  createdBy         String?
  creator           User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             QuotationItem[]
  payments          Payment[]

  @@index([status])
  @@index([quotationDate])
  @@index([customerId])
}

model QuotationItem {
  id                  String     @id @default(uuid())
  quotationId         String
  quotation           Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCodeSnapshot String?
  productNameSnapshot String
  descriptionSnapshot String?
  unit                String     @default("Bộ")
  quantity            Decimal    @default(1) @db.Decimal(14, 3)
  unitPrice           Decimal    @default(0) @db.Decimal(18, 4)
  discount            Decimal    @default(0) @db.Decimal(5, 2)
  vatRate             Decimal    @default(0) @db.Decimal(5, 2)
  subtotal            Decimal    @default(0) @db.Decimal(18, 2)
  taxableAmount       Decimal    @default(0) @db.Decimal(18, 2)
  vatAmount           Decimal    @default(0) @db.Decimal(18, 2)
  total               Decimal    @default(0) @db.Decimal(18, 2)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Payment {
  id                   String     @id @default(uuid())
  quotationId          String
  quotation            Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  amount               Decimal    @db.Decimal(18, 2)
  currency             String     @default("VND")
  gateway              String     @default("MANUAL") // MANUAL, VIETQR, BANK_TRANSFER, CASH
  gatewayTransactionId String?    @unique
  referenceCode        String?
  note                 String?
  paymentDate          DateTime   @default(now())
  recordedBy           String?
  createdAt            DateTime   @default(now())

  @@index([quotationId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  userEmail  String?
  action     String
  resource   String
  resourceId String?
  details    String?
  delta      String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  color       String?  @default("#1B9550")
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

