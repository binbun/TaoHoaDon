generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("ADMIN") // SUPER_ADMIN, ADMIN, USER
  tokenVersion Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  quotations   Quotation[]
  auditLogs    AuditLog[]
  payments     Payment[]
}

model Customer {
  id          String      @id @default(uuid())
  companyName String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxCode     String?
  openingDebt Float       @default(0) // debt owed before using the app
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quotations  Quotation[]
  payments    Payment[]
}

model Product {
  id               String          @id @default(uuid())
  code             String          @unique
  oldCode          String?
  name             String
  brand            String          @default("GROB")
  category         String          @default("Khác")
  shortDescription String?
  cabinetWidth     String?
  dimensions       String?
  unit             String          @default("Bộ")
  price            Float           @default(0)
  retailPrice      Float?          @default(0)
  discountRate     Float?          @default(0)
  vatRate          Float           @default(0)
  active           Boolean         @default(true)
  isFavorite       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  quotationItems   QuotationItem[]
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationDate   DateTime        @default(now())
  validUntil      DateTime
  title           String          @default("HÓA ĐƠN BÁN HÀNG")
  note            String?
  status          String          @default("DRAFT") // DRAFT, SENT, PAID
  subtotal        Float           @default(0)
  discountTotal   Float           @default(0)
  taxableTotal    Float           @default(0)
  vatTotal        Float           @default(0)
  orderDiscount   Float           @default(0) // "Giảm giá": fixed amount off the goods total
  discountNote    String?
  previousDebt    Float           @default(0)
  grandTotal      Float           @default(0)
  createdBy       String?
  creator         User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           QuotationItem[]
  payments        Payment[]
}

model QuotationItem {
  id                  String     @id @default(uuid())
  quotationId         String
  quotation           Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCodeSnapshot String?
  productNameSnapshot String
  descriptionSnapshot String?
  unit                String     @default("Bộ")
  quantity            Float      @default(1)
  unitPrice           Float      @default(0)
  discount            Float      @default(0)
  vatRate             Float      @default(0)
  subtotal            Float      @default(0)
  taxableAmount       Float      @default(0)
  vatAmount           Float      @default(0)
  total               Float      @default(0)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// One customer payment may be split across several orders; rows from the same payment share batchId
model Payment {
  id          String     @id @default(uuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  batchId     String
  // Invoice the payment was recorded on (null for lump sums from the customer screen); same for every row of a batch
  recordedOnQuotationId String?
  amount      Float
  paidAt      DateTime   @default(now())
  note        String?
  createdBy   String?
  creator     User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([customerId])
  @@index([quotationId])
  @@index([batchId])
  @@index([recordedOnQuotationId])
  @@map("CustomerPayment") // an unrelated legacy "Payment" table may still exist in older databases
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  userEmail  String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  color       String?  @default("#1B9550")
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

